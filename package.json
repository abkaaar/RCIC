{
  "name": "rcic",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "canvasops"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "npm run dev -w @rcic/server",
    "dev:web": "npm run dev -w @rcic/web",
    "build": "npm run build -w @rcic/web",
    "build:web": "npm run build -w @rcic/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run tests/race-sync.test.ts tests/canvasops-normalize.test.ts packages/shared/src/index.test.ts",
    "test:race": "vitest run tests/race-sync.test.ts tests/race-ws.test.ts packages/shared/src/index.test.ts",
    "test:load": "vitest run tests/load-ws.test.ts",
    "test:smoke": "node scripts/smoke-sync.mjs",
    "test:all": "vitest run",
    "deploy:hosting": "npm run build:web && firebase deploy --only hosting",
    "deploy:server": "node scripts/deploy-server.mjs",
    "deploy": "npm run deploy:server && npm run deploy:hosting",
    "canvasops:eval": "npm run eval -w @rcic/canvasops",
    "canvasops:eval:baseline": "npm run eval:baseline -w @rcic/canvasops",
    "canvasops:eval:advanced": "npm run eval:advanced -w @rcic/canvasops"
  },
  "devDependencies": {
    "concurrently": "^10.0.4",
    "firebase-tools": "^14.27.0",
    "tsx": "^4.20.5",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4",
    "ws": "^8.21.1",
    "y-websocket": "^3.0.0",
    "yjs": "^13.6.31"
  }
}
